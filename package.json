{
  "name": "fiscalsync",
  "version": "1.35.4",
  "description": "Sistema Fiscal Offline — FiscalSync",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "build": {
    "appId": "com.fiscalsync.app",
    "productName": "FiscalSync",
    "files": [
      "index.html",
      "main.js",
      "preload.js",
      "certGen.js",
      "qrPairingServer.js",
      "icon.ico",
      "assets/**/*",
      "phone-app/**/*"
    ],
    "publish": {
      "provider": "github",
      "owner": "Roger-002h",
      "repo": "fiscalsync"
    },
    "win": {
      "icon": "icon.ico",
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "icon.ico",
      "uninstallerIcon": "icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "electron": "^41.1.0",
    "electron-builder": "latest"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "nodemailer": "^8.0.5",
    "qrcode": "^1.5.4",
    "selfsigned": "^5.5.0",
    "ws": "^8.21.1"
  }
}
